# Copy this file to .env and change values for your machine:
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=notes_db
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=notes_pass

# Django
SECRET_KEY=django-insecure-change-this-key
DJANGO_DEBUG=0
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Web container
WEB_PORT=8001
NGINX_PORT=80
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
SEED_DEMO_DATA=1
SEED_DEMO_RESET=0
UVICORN_RELOAD=1

# Optional auto-created admin user.
CREATE_SUPERUSER=0
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345

# Email.
# Default console backend prints emails to container logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@notes.local
# SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=change_me
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0

# Celery
CELERY_CONCURRENCY=2
CELERY_TASK_ALWAYS_EAGER=0

# Selenium tests
SELENIUM_PORT=4444
SELENIUM_EXTERNAL_USERNAME=demo_alice
SELENIUM_EXTERNAL_PASSWORD=demo1234

# ngrok tunnel, enabled only with:
#   docker compose --profile tunnel up -d ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-subdomain.ngrok-free.app
NGROK_UI_PORT=4040
